#!/bin/bash

layout=""
capacity=""
capacity_num=""
timedate=""
status=""
brightness=""
volume=""
cpu_temp=""
dns=""
bluetooth=""
low_battery_notified=""
wifi=""
vpn=""
cpu_usage=""
prev_idle=0
prev_total=0
ram_usage=""
top_process=""
top_ram_process=""
power_watts=""
power_tenths=""
bat_path=""
bl_path=""
bl_max=""
cpu_temp_file=""
wifi_iface=""
wifi_qual=""

MISSING_COLOR=',"color":"#FF0000"'

# date/printf %()T formats weekday names with LC_TIME
export LC_TIME=en_US.UTF-8

has_cmd() {
    command -v "$1" >/dev/null 2>&1
}

missing() {
    printf 'missing: %s' "$1"
}

is_number() {
    [[ "$1" =~ ^[0-9]+$ ]]
}

is_missing() {
    case "$1" in
        missing:*) return 0 ;;
    esac
    return 1
}

get_layout() {
  layout=""

  if has_cmd xset; then
    local xset_out=$(xset -q 2>/dev/null)
    kb=""
    [[ $xset_out =~ [0-9]{8} ]] && kb="$BASH_REMATCH"

    case $kb in
      "00001000")
      layout="ru"
      ;;
      "00000000")
      layout="en"
      ;;
    esac

    [ -n "$layout" ] && return
  fi

  if has_cmd setxkbmap; then
    local active_layout=$(setxkbmap -query 2>/dev/null | awk '/layout:/ {print $2}' | awk -F, '{print $1}')
    case "$active_layout" in
      jaennil_rpd|us|en)
        layout="en"
        ;;
      ru)
        layout="ru"
        ;;
      "")
        layout="unknown"
        ;;
      *)
        layout="$active_layout"
        ;;
    esac
    return
  fi

  layout=$(missing "xset/setxkbmap")
}

find_battery() {
    bat_path="none"

    if [ -d /sys/class/power_supply/BAT0 ]; then
        bat_path="/sys/class/power_supply/BAT0"
        return
    fi

    local supply type
    for supply in /sys/class/power_supply/*; do
        [ -d "$supply" ] || continue
        read -r type < "$supply/type" 2>/dev/null || continue
        [ "$type" = "Battery" ] || continue
        bat_path="$supply"
        return
    done
}

battery() {
    [ -z "$bat_path" ] && find_battery

    if [ "$bat_path" = "none" ]; then
        capacity_num=""
        capacity="no battery"
        status=""
        power_watts=""
        power_tenths=""
        return
    fi

    read -r capacity_num < "$bat_path/capacity" 2>/dev/null
    capacity="${capacity_num}%"
    read -r status < "$bat_path/status" 2>/dev/null

    # power in watts, kept as tenths so the loop can compare it without awk
    local power_uw="" current_ua voltage_uv
    if [ -f "$bat_path/power_now" ]; then
        read -r power_uw < "$bat_path/power_now"
    elif [ -f "$bat_path/current_now" ] && [ -f "$bat_path/voltage_now" ]; then
        read -r current_ua < "$bat_path/current_now"
        read -r voltage_uv < "$bat_path/voltage_now"
        power_uw=$(( current_ua * voltage_uv / 1000000 ))
    fi

    if [ -n "$power_uw" ]; then
        power_tenths=$(( power_uw / 100000 ))
        power_watts="$((power_tenths / 10)).$((power_tenths % 10))W"
    else
        power_tenths=""
        power_watts="N/A"
    fi
}

timedate() {
    printf -v timedate '%(%A %d-%m-%Y %H:%M:%S)T' -1
}

brightness() {
    if [ -z "$bl_path" ]; then
        bl_path="none"
        local bl
        for bl in /sys/class/backlight/*; do
            [ -r "$bl/brightness" ] || continue
            bl_path="$bl"
            read -r bl_max < "$bl/max_brightness"
            break
        done
    fi

    if [ "$bl_path" = "none" ] || [ -z "$bl_max" ] || [ "$bl_max" -eq 0 ]; then
        brightness="N/A"
        return
    fi

    local cur
    read -r cur < "$bl_path/brightness"
    brightness=$((cur * 100 / bl_max))%
}

volume() {
    volume=""

    if has_cmd pactl; then
        local pactl_vol=$(pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null)
        local vol=""
        [[ $pactl_vol =~ ([0-9]+)% ]] && vol="${BASH_REMATCH[1]}%"
        local mute=$(pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null)
        mute="${mute##* }"

        if [ -n "$vol" ]; then
            if [ "$mute" = "yes" ]; then
                volume="${vol} [off]"
            else
                volume="${vol} [on]"
            fi
            return
        fi
    fi

    if has_cmd wpctl; then
        local wpctl_status=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null)
        local wpctl_volume=$(echo "$wpctl_status" | awk '/^Volume: [0-9.]+/ {printf "%d%%", $2 * 100}')

        if [ -n "$wpctl_volume" ]; then
            if echo "$wpctl_status" | grep -q '\[MUTED\]'; then
                volume="${wpctl_volume} [off]"
            else
                volume="${wpctl_volume} [on]"
            fi
            return
        fi
    fi

    if has_cmd amixer; then
        volume=$(amixer sget Master 2>/dev/null | awk '/Front Left:/ {print $5 $6; exit}')
        [ -n "$volume" ] && return
    fi

    volume=$(missing "amixer/pactl/wpctl")
}

find_cpu_temp_file() {
    cpu_temp_file="none"

    local z hwmon f name
    for z in /sys/class/thermal/thermal_zone*; do
        read -r name < "$z/type" 2>/dev/null || continue
        case "$name" in
            x86_pkg_temp|coretemp|k10temp)
                cpu_temp_file="$z/temp"
                return
                ;;
        esac
    done

    for hwmon in /sys/class/hwmon/hwmon*; do
        read -r name < "$hwmon/name" 2>/dev/null || continue
        case "$name" in
            x86_pkg_temp|coretemp|k10temp) ;;
            *) continue ;;
        esac
        for f in "$hwmon"/temp*_input; do
            [ -r "$f" ] || continue
            cpu_temp_file="$f"
            return
        done
    done

    for z in /sys/class/thermal/thermal_zone*; do
        [ -r "$z/temp" ] || continue
        cpu_temp_file="$z/temp"
        return
    done
}

cpu_temp() {
    [ -z "$cpu_temp_file" ] && find_cpu_temp_file

    if [ "$cpu_temp_file" = "none" ]; then
        cpu_temp="N/A"
        return
    fi

    local raw
    read -r raw < "$cpu_temp_file"
    printf -v cpu_temp '%3d°C' $((raw / 1000))
}

cpu_usage() {
    local _cpu user nice system idle iowait irq softirq
    read -r _cpu user nice system idle iowait irq softirq _ < /proc/stat

    local total=$((user + nice + system + idle + iowait + irq + softirq))
    local diff_idle=$((idle - prev_idle))
    local diff_total=$((total - prev_total))

    if [ "$diff_total" -gt 0 ]; then
        cpu_usage=$((100 * (diff_total - diff_idle) / diff_total))%
    else
        cpu_usage="0%"
    fi

    prev_idle=$idle
    prev_total=$total
}

ram_usage() {
    local total=0 available=0 key val
    while read -r key val _; do
        case "$key" in
            MemTotal:) total=$val ;;
            MemAvailable:) available=$val; break ;;
        esac
    done < /proc/meminfo

    [ "$total" -eq 0 ] && { ram_usage="N/A"; return; }
    local used=$((total - available))
    ram_usage=$((used * 100 / total))%
}

# ps is ~5x cheaper than top -bn1 and reports the same
# since-start cpu share that top's first iteration does
format_top() {
    awk '{
        pct = $1
        $1 = ""
        sub(/^ +/, "")
        if ($0 == "ps") next  # skip our own probe, it always looks busy
        name = substr($0, 1, 8)
        pad = int((8 - length(name)) / 2)
        printf "%*s%-*s %3.0f%%", pad, "", 8 - pad, name, pct
        exit
    }'
}

top_process() {
    top_process=$(ps -eo pcpu=,comm= --sort=-pcpu | format_top)
}

top_ram_process() {
    top_ram_process=$(ps -eo pmem=,comm= --sort=-pmem | format_top)
}

dns() {
    if has_cmd nmcli; then
        dns=$(nmcli dev show 2>/dev/null | awk '/IP4.DNS/ {print $2}' | tr '\n' ' ' | sed 's/ $//' | sed 's/ /  /g')
    else
        dns=$(missing "nmcli")
    fi
}

find_wifi_iface() {
    wifi_iface="none"

    local d
    for d in /sys/class/net/*/wireless; do
        [ -d "$d" ] || continue
        d=${d%/wireless}
        wifi_iface=${d##*/}
        return
    done
}

wifi_quality() {
    wifi_qual=""
    [ "$wifi_iface" = "none" ] && return

    # link quality in /proc/net/wireless is out of 70
    local ifc link
    while read -r ifc _ link _; do
        [ "$ifc" = "$wifi_iface:" ] || continue
        link=${link%.}
        [ -n "$link" ] && printf -v wifi_qual '%d%%' $((link * 100 / 70))
        return
    done < /proc/net/wireless
}

wifi() {
    local ssid=""

    [ -z "$wifi_iface" ] && find_wifi_iface

    if has_cmd iwgetid; then
        ssid=$(iwgetid -r 2>/dev/null)
    fi

    # iw asks the kernel; nmcli dev wifi would kick off a rescan and
    # block the whole bar for seconds every couple of minutes
    if [ -z "$ssid" ] && [ "$wifi_iface" != "none" ] && has_cmd iw; then
        local link=$(iw dev "$wifi_iface" link 2>/dev/null)
        [[ $link =~ SSID:\ ([^$'\n']*) ]] && ssid=${BASH_REMATCH[1]}
    fi

    if [ -z "$ssid" ] && has_cmd nmcli; then
        # connection show does not scan either
        ssid=$(nmcli -t -f TYPE,NAME connection show --active 2>/dev/null | awk -F: '$1 == "802-11-wireless" {print $2; exit}')
    fi

    if [ -n "$ssid" ]; then
        wifi_quality
        wifi="$ssid $wifi_qual"
        return
    fi

    if has_cmd nmcli; then
        if nmcli -t -f TYPE,STATE dev status 2>/dev/null | grep -q '^wifi:connected$'; then
            wifi="connected"
            return
        fi
    fi

    if ! has_cmd iwgetid && ! has_cmd iw && ! has_cmd nmcli; then
        wifi=$(missing "iwgetid/iw/nmcli")
        return
    fi

    wifi="down"
}

vpn() {
    if ! has_cmd nmcli; then
        vpn=$(missing "nmcli")
    elif nmcli -t -f TYPE,STATE connection show --active 2>/dev/null | grep -q "^vpn:"; then
        vpn="up"
    else
        vpn="down"
    fi
}

bluetooth() {
    if ! has_cmd bluetoothctl; then
        bluetooth=$(missing "bluetoothctl")
        bluetooth_battery=""
        return
    fi

    # bluetoothctl hangs forever when bluetoothd is down, so the
    # timeouts below would burn a second on every tick
    if has_cmd busctl && ! busctl --system status org.bluez >/dev/null 2>&1; then
        bluetooth="off"
        bluetooth_battery=""
        return
    fi

    local devices=$(timeout 1s bluetoothctl devices Connected 2>/dev/null | awk '{print $2}')
    if [ -z "$devices" ]; then
        bluetooth="-"
        bluetooth_battery=""
        return
    fi

    local names=""
    local batteries=""
    for mac in $devices; do
        local name=$(timeout 1s bluetoothctl info "$mac" 2>/dev/null | awk -F': ' '/Name:/ {print $2}')
        [ -z "$name" ] && name="$mac"
        names="${names}${name}, "

        local bat=""
        if has_cmd upower; then
            bat=$(timeout 1s upower -e 2>/dev/null | grep -i "${mac//:/_}" | xargs -r -I{} timeout 1s upower -i {} 2>/dev/null | awk '/percentage:/ {print $2}' | tr -d '%')
        fi
        [ -n "$bat" ] && batteries="${batteries}${bat}% " || batteries="${batteries}N/A "
    done

    bluetooth="${names%, }"
    bluetooth_battery="${batteries% }"
}

# escapes $2 into the variable named by $1, without forking a subshell
json_escape_into() {
    local _esc=${2//\\/\\\\}
    _esc=${_esc//\"/\\\"}
    _esc=${_esc//[[:cntrl:]]/}
    printf -v "$1" '%s' "$_esc"
}

handle_clicks() {
    while IFS= read -r click_event; do
        case "$click_event" in
            *'"name":"brightness"'*)
                ~/.config/bin/brightness-slider.sh >/dev/null 2>&1 &
                ;;
        esac
    done
}

output_status() {
# Output JSON header for i3bar protocol
echo '{"version":1,"click_events":true}'
echo '['
echo '[]'

# one tick is 0.1s; collectors that cost more than a few ms run on a
# slower cadence so the clock, volume and layout stay snappy
tick=0
period_us=100000
while :
do
  loop_start=${EPOCHREALTIME/[.,]/}

  get_layout
  battery
  brightness
  timedate
  volume
  ram_usage

  json_escape_into volume_e "$volume"

  # cpu deltas need a window wider than one tick to be readable
  if (( tick % 5 == 0 )); then
    cpu_temp
    cpu_usage
  fi

  # the expensive collectors refresh every 2s, staggered over different
  # ticks so no single tick blows past the 0.1s period
  case $((tick % 20)) in
    0)
      top_process
      json_escape_into top_process_e "$top_process"
      ;;
    5)
      top_ram_process
      json_escape_into top_ram_process_e "$top_ram_process"
      ;;
    10)
      dns
      vpn
      json_escape_into dns_e "$dns"
      ;;
    15)
      wifi
      bluetooth
      json_escape_into wifi_e "$wifi"
      json_escape_into bluetooth_e "$bluetooth"
      json_escape_into bluetooth_battery_e "$bluetooth_battery"
      ;;
  esac

  # Low battery notification
  if is_number "$capacity_num" && [ "$capacity_num" -le 20 ] && [ "$status" = "Discharging" ] && [ -z "$low_battery_notified" ]; then
      notify-send -u critical "Low Battery" "Battery at ${capacity_num}%"
      low_battery_notified="1"
  elif { is_number "$capacity_num" && [ "$capacity_num" -gt 20 ]; } || [ "$status" = "Charging" ]; then
      low_battery_notified=""
  fi

  # Battery status color
  if [ "$status" = "Charging" ]; then
      status_color=',"color":"#00FF00"'  # green
  elif [ "$status" = "Discharging" ]; then
      status_color=',"color":"#FFFF00"'  # yellow
  else
      status_color=""
  fi

  # Battery capacity color
  if ! is_number "$capacity_num"; then
      capacity_color=""
  elif [ "$capacity_num" -lt 30 ]; then
      capacity_color=',"color":"#FF0000"'  # red
  elif [ "$capacity_num" -lt 60 ]; then
      capacity_color=',"color":"#FFFF00"'  # yellow
  else
      capacity_color=',"color":"#00FF00"'  # green
  fi

  # CPU temp color
  cpu_temp_num=${cpu_temp//[^0-9]/}
  if [ "$cpu_temp_num" -gt 95 ] 2>/dev/null; then
      cpu_color=',"color":"#FF0000"'  # red - hot
  elif [ "$cpu_temp_num" -gt 65 ] 2>/dev/null; then
      cpu_color=',"color":"#FF6600"'  # orange - warm
  else
      cpu_color=',"color":"#00FF00"'  # green - normal
  fi

  wifi_color=""
  is_missing "$wifi" && wifi_color=$MISSING_COLOR
  bluetooth_color=""
  is_missing "$bluetooth" && bluetooth_color=$MISSING_COLOR
  dns_color=""
  is_missing "$dns" && dns_color=$MISSING_COLOR

  # Volume color
  if is_missing "$volume"; then
      volume_color=$MISSING_COLOR
  elif echo "$volume" | grep -q "\[off\]"; then
      volume_color=',"color":"#00FF00"'  # green - muted
  else
      volume_color=',"color":"#FF6600"'  # orange - on
  fi

  # DNS color (red if stage)
  stage_dns="10.13.245.31"
  if [ -n "$dns_color" ]; then
      dns_suffix=""
  elif [ "$dns" = "$stage_dns" ]; then
      dns_color=',"color":"#FF0000"'
      dns_suffix=" (stage)"
  else
      dns_color=""
      dns_suffix=""
  fi

  # Bluetooth battery color
  bt_bat_num=""
  [[ $bluetooth_battery =~ ^([0-9]+) ]] && bt_bat_num=${BASH_REMATCH[1]}
  if [ -n "$bt_bat_num" ]; then
      if [ "$bt_bat_num" -lt 10 ]; then
          bt_bat_color=',"color":"#FF0000"'  # red
      elif [ "$bt_bat_num" -lt 20 ]; then
          bt_bat_color=',"color":"#FF6600"'  # orange
      elif [ "$bt_bat_num" -lt 40 ]; then
          bt_bat_color=',"color":"#FFFF00"'  # yellow
      else
          bt_bat_color=',"color":"#00FF00"'  # green - good
      fi
  else
      bt_bat_color=""
  fi

  # VPN color
  if is_missing "$vpn"; then
      vpn_color=$MISSING_COLOR
  elif [ "$vpn" = "up" ]; then
      vpn_color=',"color":"#FF6600"'  # orange
  else
      vpn_color=',"color":"#00FF00"'  # green
  fi

  # Layout color
  if is_missing "$layout"; then
      layout_color=$MISSING_COLOR
  elif [ "$layout" = "en" ]; then
      layout_color=',"color":"#00FF00"'  # green
  else
      layout_color=',"color":"#FFFF00"'  # yellow
  fi

  # Power watts color (power_tenths is watts * 10)
  if [ -n "$power_tenths" ]; then
      if [ "$power_tenths" -lt 100 ]; then
          power_color=',"color":"#00FF00"'  # green - low power
      elif [ "$power_tenths" -lt 300 ]; then
          power_color=',"color":"#FFFF00"'  # yellow - medium power
      else
          power_color=',"color":"#FF6600"'  # orange - high power
      fi
  else
      power_color=""
  fi

  # CPU usage color
  cpu_usage_num=${cpu_usage//[^0-9]/}
  if [ "$cpu_usage_num" -gt 90 ] 2>/dev/null; then
      cpu_usage_color=',"color":"#FF0000"'  # red - critical
  elif [ "$cpu_usage_num" -gt 70 ] 2>/dev/null; then
      cpu_usage_color=',"color":"#FF6600"'  # orange - high
  elif [ "$cpu_usage_num" -gt 50 ] 2>/dev/null; then
      cpu_usage_color=',"color":"#FFFF00"'  # yellow - medium
  else
      cpu_usage_color=',"color":"#00FF00"'  # green - normal
  fi

  # RAM usage color
  ram_usage_num=${ram_usage//[^0-9]/}
  if [ "$ram_usage_num" -gt 90 ] 2>/dev/null; then
      ram_usage_color=',"color":"#FF0000"'  # red - critical
  elif [ "$ram_usage_num" -gt 70 ] 2>/dev/null; then
      ram_usage_color=',"color":"#FF6600"'  # orange - high
  elif [ "$ram_usage_num" -gt 50 ] 2>/dev/null; then
      ram_usage_color=',"color":"#FFFF00"'  # yellow - medium
  else
      ram_usage_color=',"color":"#00FF00"'  # green - normal
  fi

  echo ",[
    {\"full_text\":\"cpu: \",\"separator\":false,\"separator_block_width\":0},
    {\"full_text\":\"$cpu_temp\"$cpu_color,\"separator\":false,\"separator_block_width\":0},
    {\"full_text\":\" \",\"separator\":false,\"separator_block_width\":0},
    {\"full_text\":\"$cpu_usage\"$cpu_usage_color,\"separator\":false,\"separator_block_width\":0},
    {\"full_text\":\" \",\"separator\":false,\"separator_block_width\":0},
    {\"full_text\":\"$top_process_e\",\"separator\":false,\"separator_block_width\":0},
    {\"full_text\":\" | ram: \",\"separator\":false,\"separator_block_width\":0},
    {\"full_text\":\"$ram_usage\"$ram_usage_color,\"separator\":false,\"separator_block_width\":0},
    {\"full_text\":\" \",\"separator\":false,\"separator_block_width\":0},
    {\"full_text\":\"$top_ram_process_e\",\"separator\":false,\"separator_block_width\":0},
    {\"full_text\":\" | wifi: \",\"separator\":false,\"separator_block_width\":0},
    {\"full_text\":\"$wifi_e\"$wifi_color,\"separator\":false,\"separator_block_width\":0},
    {\"full_text\":\" | vpn: \",\"separator\":false,\"separator_block_width\":0},
    {\"full_text\":\"$vpn\"$vpn_color,\"separator\":false,\"separator_block_width\":0},
    {\"full_text\":\" | bt: \",\"separator\":false,\"separator_block_width\":0},
    {\"full_text\":\"$bluetooth_e\"$bluetooth_color,\"separator\":false,\"separator_block_width\":0},
    {\"full_text\":\" \",\"separator\":false,\"separator_block_width\":0},
    {\"full_text\":\"$bluetooth_battery_e\"$bt_bat_color,\"separator\":false,\"separator_block_width\":0},
    {\"full_text\":\" | dns: \",\"separator\":false,\"separator_block_width\":0},
    {\"full_text\":\"$dns_e$dns_suffix\"$dns_color,\"separator\":false,\"separator_block_width\":0},
    {\"full_text\":\" | volume: \",\"separator\":false,\"separator_block_width\":0},
    {\"full_text\":\"$volume_e\"$volume_color,\"separator\":false,\"separator_block_width\":0},
    {\"full_text\":\" | brightness: \",\"separator\":false,\"separator_block_width\":0},
    {\"name\":\"brightness\",\"full_text\":\"$brightness\",\"separator\":false,\"separator_block_width\":0},
    {\"full_text\":\" | \",\"separator\":false,\"separator_block_width\":0},
    {\"full_text\":\"$capacity\"$capacity_color,\"separator\":false,\"separator_block_width\":0},
    {\"full_text\":\" \",\"separator\":false,\"separator_block_width\":0},
    {\"full_text\":\"$status\"$status_color,\"separator\":false,\"separator_block_width\":0},
    {\"full_text\":\" \",\"separator\":false,\"separator_block_width\":0},
    {\"full_text\":\"$power_watts\"$power_color,\"separator\":false,\"separator_block_width\":0},
    {\"full_text\":\" | \",\"separator\":false,\"separator_block_width\":0},
    {\"full_text\":\"$layout\"$layout_color,\"separator\":false,\"separator_block_width\":0},
    {\"full_text\":\" | \",\"separator\":false,\"separator_block_width\":0},
    {\"full_text\":\"$timedate\"}
  ]"

  tick=$((tick + 1))

  left_us=$((period_us - (${EPOCHREALTIME/[.,]/} - loop_start)))
  if [ "$left_us" -gt 0 ]; then
      printf -v left_frac '%06d' "$left_us"
      sleep "0.$left_frac"
  fi
done
}

output_status &
output_pid=$!

trap 'kill "$output_pid" 2>/dev/null' EXIT INT TERM
handle_clicks
wait "$output_pid"
